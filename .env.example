# DKaimono-AM Environment Variables
# Salin ke file .env untuk lokal, atau masukkan ke Netlify Dashboard -> Site configuration -> Environment variables

# 1. Koneksi Database PostgreSQL (Neon Serverless) - WAJIB
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Kunci Kriptografi Sesi & Hash Voucher (Gunakan string acak minimal 32 karakter) - WAJIB
SESSION_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
VOUCHER_PEPPER=ganti_dengan_pepper_acak_minimal_32_karakter

# 3. Password Awal Dashboard Admin (/admin) - WAJIB
ADMIN_PASSWORD=ganti_dengan_password_admin_kuat

# 4. Opsional: Nomor WhatsApp Admin Default (Format 628xxx, juga bisa diubah langsung dari /admin)
# ADMIN_WHATSAPP=6281234567890

# 5. Opsional: Google Play Purchase Token & Rotasi Cadangan
# AM_PURCHASE_TOKEN=token_utama
# AM_PURCHASE_TOKENS=token_utama,token_cadangan_1,token_cadangan_2
# AM_PRODUCT_ID=am.full.sub.annual.19q4

# 6. Port Server Lokal
PORT=3300
